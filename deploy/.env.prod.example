# Variables de producción (SPEC-11 §6.3). Copiar a .env en la raíz del clon del backend:
#   cp deploy/.env.prod.example .env && chmod 600 .env
# Cada secreto se guarda también en el gestor de contraseñas del equipo (§6.10).
# Nunca versionar .env. Toda variable nueva de un módulo va acá y en .env.example (X4).

# --- Base de datos ------------------------------------------------------------
# compose.prod.yaml arma DATABASE_URL con estas tres. Generar la contraseña con:
#   openssl rand -base64 32
POSTGRES_USER=prestamedios
POSTGRES_PASSWORD=
POSTGRES_DB=prestamedios

# --- Aplicación ----------------------------------------------------------------
# ENTORNO=produccion lo fija compose.prod.yaml. Cambiar el secreto cierra todas las
# sesiones (EC-P05). Generar con: openssl rand -base64 48
JWT_SECRET_KEY=
# Dominio público con https:// (sin barra final). No puede ser localhost (AC-P11).
FRONTEND_URL=https://prestamedios.example.com
CORS_ORIGINS=https://prestamedios.example.com
# Procesos de uvicorn (2 alcanza para el laboratorio).
# WEB_CONCURRENCY=2

# --- Correo (proveedor transaccional, D-14) -------------------------------------
# Remitente del dominio propio, con SPF, DKIM y DMARC configurados en Cloudflare.
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PrestaMeDios <no-responder@prestamedios.example.com>
# Límite diario del plan gratuito vigente (§6.7), con un margen.
EMAIL_LIMITE_DIARIO=280

# --- Túnel de Cloudflare (D-11) -------------------------------------------------
# Token del túnel (Zero Trust → Networks → Tunnels). El hostname público apunta a
# http://web:80.
TUNNEL_TOKEN=

# --- Copias de seguridad (D-09, D-13) -------------------------------------------
# Clave PÚBLICA de age (empieza con age1…). La privada va SÓLO al gestor de
# contraseñas, nunca a esta máquina (AC-P21). Generar en otra máquina con: age-keygen
BACKUP_CLAVE_PUBLICA=
# Remoto de rclone y bucket.
BACKUP_DESTINO=r2:prestamedios-copias
# Remoto "r2" de rclone por variables (Cloudflare R2 → API tokens de R2, permiso
# de lectura y escritura sólo sobre el bucket).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# --- Monitoreo (D-15) -----------------------------------------------------------
# URLs de latido de Healthchecks.io, una por tarea del crontab.
MONITOREO_PING_BACKUP=
MONITOREO_PING_LIMPIEZA=

# --- Resto ----------------------------------------------------------------------
# Los demás valores de .env.example (archivos, recuperación de contraseña, sesión)
# tienen valores por defecto adecuados; agregarlos sólo para cambiarlos.
