# Copiar a `.env` y completar. NUNCA versionar `.env`.

# --- Sólo con Docker (`docker compose up`, SPEC-11) ---------------------------
# Contraseña del PostgreSQL del contenedor (obligatoria con Docker). Compose arma
# DATABASE_URL, TEST_DATABASE_URL y el SMTP hacia los contenedores; las variables
# de abajo para esas tres cosas sólo valen en el camino manual.
POSTGRES_PASSWORD=
# POSTGRES_USER=prestamedios
# Puertos del host, si los de siempre están ocupados:
# POSTGRES_PUERTO_HOST=5432
# API_PUERTO_HOST=8000
# MAILPIT_PUERTO_HOST=8025
# ------------------------------------------------------------------------------

# Base de datos principal (PostgreSQL 15+, extensión btree_gist).
DATABASE_URL=postgresql+asyncpg://USUARIO:CLAVE@localhost:5432/prestamedios

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:8443

# Secreto de firma JWT (obligatorio, >= 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Vida del access token en minutos (SPEC-01 §6.2). El frontend lo renueva con
# actividad del usuario (SPEC-03 §7).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Tope absoluto de una sesión en horas desde el login: pasado este tiempo
# `POST /auth/renovar` responde 401 TOKEN_SESION_MAXIMA (SPEC-03 RN-66).
JWT_SESION_MAX_HORAS=8

# Base dedicada a tests de integración (nunca la de desarrollo).
TEST_DATABASE_URL=postgresql+asyncpg://USUARIO:CLAVE@localhost:5432/prestamedios_test

# Opcional: contraseña para `python -m app.modules.users.cli crear-superadmin`
# (si no se define, se solicita por prompt oculto).
# BOOTSTRAP_SUPERADMIN_PASSWORD=

# Archivos (SPEC-03 §6.2): tamaño máximo de la foto de perfil y del PDF de aval (MB),
# horas tras las que `limpiar-huerfanos` borra lo no vinculado y tope de archivos
# sin vincular por usuario.
ARCHIVO_FOTO_MAX_MB=2
ARCHIVO_PDF_MAX_MB=10
ARCHIVO_HUERFANO_HORAS=24
ARCHIVO_MAX_PENDIENTES=5

# Correo (SPEC-03 §5.1). `smtp` o `memoria` (sólo tests). En desarrollo, Mailpit:
#   docker run -d -p 1025:1025 -p 8025:8025 axllent/mailpit   (bandeja en http://localhost:8025)
# y SMTP_TLS=ninguno. Las credenciales reales van sólo en `.env`.
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=ninguno
EMAIL_FROM=PrestaMeDios <no-responder@localhost>
# Base de los enlaces que van en los correos (frontend).
FRONTEND_URL=http://localhost:8443

# Tope de correos por día (SPEC-11 §6.7). Sin definir, sin límite. En producción,
# el límite del plan gratuito del proveedor (p. ej. 300).
# EMAIL_LIMITE_DIARIO=

# Recuperación de contraseña (SPEC-03 §5.2): vida del enlace y límites por hora.
RECUPERACION_VIGENCIA_MINUTOS=30
RECUPERACION_MAX_POR_EMAIL_HORA=3
RECUPERACION_MAX_POR_IP_HORA=20

# Entorno (SPEC-11 §6.9): `desarrollo` o `produccion`. En producción se apaga /docs y
# la app no arranca con localhost en FRONTEND_URL/CORS_ORIGINS ni con EMAIL_BACKEND=memoria.
ENTORNO=desarrollo
# Proxies de confianza (IPs o CIDR, separados por coma) para X-Forwarded-For.
FORWARDED_ALLOW_IPS=127.0.0.1
