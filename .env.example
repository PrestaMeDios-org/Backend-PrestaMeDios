# Copiar a `.env` y completar. NUNCA versionar `.env`.

# Base de datos principal (PostgreSQL 15+, extensión btree_gist).
DATABASE_URL=postgresql+asyncpg://USUARIO:CLAVE@localhost:5432/prestamedios

# Orígenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:8443

# Secreto de firma JWT (obligatorio, >= 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Vida del access token en minutos (SPEC-01 §6.2).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base dedicada a tests de integración (nunca la de desarrollo).
TEST_DATABASE_URL=postgresql+asyncpg://USUARIO:CLAVE@localhost:5432/prestamedios_test

# Opcional: contraseña para `python -m app.modules.users.cli crear-superadmin`
# (si no se define, se solicita por prompt oculto).
# BOOTSTRAP_SUPERADMIN_PASSWORD=

# Archivos (SPEC-03 §6.2): tamaño máximo de la foto de perfil y del PDF de aval (MB),
# horas tras las que `limpiar-huerfanos` borra lo no vinculado y tope de archivos
# sin vincular por usuario.
ARCHIVO_FOTO_MAX_MB=2
ARCHIVO_PDF_MAX_MB=10
ARCHIVO_HUERFANO_HORAS=24
ARCHIVO_MAX_PENDIENTES=5
